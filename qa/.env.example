# Copia este archivo a `.env` y llena los valores. El .env NO se sube al repo.
# ───────────────────────────────────────────────────────────────────────────
# Frontend: la URL donde navega Playwright.
#   · Local  : http://localhost:5173  (vite dev; proxya /api -> :3000)
#   · Render  : https://<tu-servicio-frontend>.onrender.com
BASE_URL=http://localhost:5173

# Backend: el ORIGEN del API (health en /health, API en /api/v1).
#   · Local  : http://localhost:3000
#   · Render  : https://<tu-servicio-backend>.onrender.com
API_BASE=http://localhost:3000

# Cuenta de prueba con rol ADMIN o grupo de trabajo ADMIN_ALL (ve todos los módulos).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# (Opcional) Cuenta con grupo de trabajo ACOTADO para probar RBAC.
# Recomendado: una cuenta PUNTO_VENTA (la más restringida: solo POS + mensajes).
# Si se deja vacío, las pruebas de RBAC por grupo se marcan como SKIPPED (no fallan).
TEST_LIMITED_EMAIL=
TEST_LIMITED_PASSWORD=
# La "casa" del grupo acotado (a dónde debe rebotar). PUNTO_VENTA -> /pos
TEST_LIMITED_HOME=/pos
